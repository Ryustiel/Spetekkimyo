# =============================================================================
# SEISO / canonical draft feature file
# =============================================================================
#
# This file is the current canonical GSUB/GPOS logic draft for the Seiso font.
#
# Design constraints carried over from the original documents and revisions:
# - Everything important must live in one required ccmp feature because web
#   engines often ignore more specialized features.
# - The script is not "Latin with stylistic alternates"; the font reconstructs
#   a different writing behavior from Latin input.
# - The main line-building logic should ignore floating marks, so all floating
#   material is classified as marks in GDEF and many lookups use IgnoreMarks.
# - "high / high-mid / mid / low" are logical connection families and drawing
#   guidance, NOT OpenType anchor tables.
# - Final vertical placement is expected to be done with GPOS later. The logic
#   here focuses on structural substitutions and the glyph sequence itself.
#
# This file is meant to be both:
#   1. readable by a human / another LLM,
#   2. close to compilable once the helper glyphs listed in font_logic.txt exist.
#
# =============================================================================
languagesystem DFLT dflt;
languagesystem latn dflt;
# -----------------------------------------------------------------------------
# GDEF
# -----------------------------------------------------------------------------
# Mark glyphs:
# - floating_i / floating_j / floating_h / floating_l are ignored by line
#   lookups so the line can join "through" them.
# - coda_j / coda_h / coda_l and the width-specific l forms are also marks.
# - d_mark / d_mark_ps are marks above the d-family.
# -----------------------------------------------------------------------------
table GDEF {
    GlyphClassDef
        [], # Base glyphs
        [
            _sq_
            _s__ll_l
            _s__ls_l
        ], # Ligature glyphs
        [
            floating_i
            floating_j
            floating_h
            floating_l
            coda_j
            coda_h
            coda_l
            ll_l
            sl_l
            ls_l
            ss_l
            ll_coda_l
            sl_coda_l
            ls_coda_l
            ss_coda_l
            d_mark
            d_mark_ps
        ], # Mark glyphs
        [] # Component glyphs
        ;
} GDEF;
# -----------------------------------------------------------------------------
# RAW / PRE-SPLIT CLASSES
# -----------------------------------------------------------------------------
@RAW_INLINE            = [a e p o b b2 y c u u2 i];
@RAW_INLINE_NO_I       = [a e p o b b2 y c u u2];
@RAW_LINE_CODA         = [f n t s];
# Solid consonants that may participate in onset logic.
# d is first normalized to d_seed + d_mark.
@RAW_SOLID             = [k t f s n q d_seed g];
# Standalone valid onset tails before a nucleus.
@RAW_ONSET_TAILS       = [k t f s n q d_seed g];
# Valid two-solid onset heads, in the latest frozen interpretation:
#   st sf ts tk tf ks kt kf fs
# which means the possible first solid is one of:
@RAW_ONSET_HEADS       = [s t k f];
# Used for the "one optional floating after the onset" parser idea.
@RAW_FLOATING_INPUT    = [j h l];
# Raw vowels grouped by how l must size above them.
@RAW_L_LL              = [a p];
@RAW_L_SS              = [o y c];
@RAW_L_LS              = [e b u];
@RAW_L_SL              = [b2 u2];
# -----------------------------------------------------------------------------
# SHAPED / POST-SPLIT CLASSES
# -----------------------------------------------------------------------------
# Split left halves:
# - a_, used by a / e / p
# - o_, used by o / y / b2
# - c_, unique
# - b_, unique
# - u_, unique
# - u2_, unique
@LEFT_A                = [a_];
@LEFT_O                = [o_];
@LEFT_C                = [c_];
@LEFT_B                = [b_];
@LEFT_U                = [u_];
@LEFT_U2               = [u2_];
@LEFT_ANY              = [a_ o_ c_ b_ u_ u2_];
# Left families used by k/f and n/g:
@LEFT_MID_CLASS        = [a_ c_ b_ u_ u2_];
@LEFT_LOW_CLASS        = [o_];
# Right-side classes used to finalize codas after the vowel has chosen its
# right-side form.
@RIGHT_MID_CLASS       = [_a_mid_ _p_mid_ _c_mid_ _b2_mid_ _u_mid_];
@RIGHT_LOW_CLASS       = [_e_low_ _o_low_ _y_low_ _u2_low_];
# -----------------------------------------------------------------------------
# HELPER / STATE CLASSES
# -----------------------------------------------------------------------------
@ONSET_SINGLE_STATES   = [onset_k onset_t onset_d onset_f onset_s onset_n onset_q onset_g];
@ONSET_CLUSTER_STATES  = [onset_st onset_sf onset_ts onset_tk onset_tf onset_ks onset_kt onset_kf onset_fs];
@ONSET_ALL_STATES      = [@ONSET_SINGLE_STATES @ONSET_CLUSTER_STATES];
# body_t / body_d / body_s are zero-logic helper glyphs:
# - they are not final drawings
# - they exist only so a later lookup can replace them contextually by the
#   correct "_t_*", "_d_*" or "_s_*" right piece.
@HELPER_BODIES         = [body_t body_d body_s];
feature ccmp {
    script DFLT;
    language dflt required;
    script latn;
    language dflt required;
    # =========================================================================
    # PASS 0 — INPUT NORMALIZATION
    # =========================================================================
    # B -> b2
    # U -> u2
    # S -> prefix_s
    # F -> prefix_f
    #
    # typed d:
    #   d is not a separate body family; it is "d-family + d mark".
    #   We split it into d_seed + d_mark so structural logic can still decide
    #   whether it becomes onset_d or isolated_d later.
    # =========================================================================
    lookup INPUT_NORMALIZATION {
        sub B by b2;
        sub U by u2;
        sub S by prefix_s;
        sub F by prefix_f;
        sub d by d_seed d_mark;
    } INPUT_NORMALIZATION;
    # =========================================================================
    # PASS 1 — SPECIAL NORMALIZATION FOR ji / ij
    # =========================================================================
    # Latest decision:
    # - ji and ij should both behave like a full-width inline i carrying a
    #   single floating j.
    #
    # We normalize them through helper ligatures so the sequence becomes:
    #   i + floating_j
    # =========================================================================
    lookup NORMALIZE_JI_IJ {
        sub j i by ji_helper;
        sub i j by ij_helper;
    } NORMALIZE_JI_IJ;
    lookup EXPAND_JI_IJ {
        sub ji_helper by i floating_j;
        sub ij_helper by i floating_j;
    } EXPAND_JI_IJ;
    # =========================================================================
    # PASS 2 — RAW FLOATING HINTS (j / h / l / i)
    # =========================================================================
    # This is the earliest pass that starts deciding which letters should
    # become mark-like so the later line-building passes can IgnoreMarks.
    #
    # j / h / l:
    # - between vowels => floating
    # - between a solid onset and a nucleus => floating
    # - after a nucleus with no later inline continuation => coda-like
    #
    # i:
    # - between inline vowels => floating_i
    # - between a solid onset and a nucleus => floating_i
    # - before line codas f / n / t / s => floating_i
    # - before k in coda position => full-width coda-like i (aliased later to
    #   isolated_i)
    # - before a valid onset => prefix_i
    #
    # NOTE:
    # The remaining truly awkward edge case from the discussion is the exact
    # "bad double floating" split behavior (jj, hh, etc.). The canonical logic
    # file records that explicitly, but the feature implementation below focuses
    # first on the core line-building path.
    # =========================================================================
    lookup RAW_FLOATING_HINTS {
        lookupflag IgnoreMarks;
        # j / h / l between vowels
        sub @RAW_INLINE_NO_I j' @RAW_INLINE by floating_j;
        sub @RAW_INLINE_NO_I h' @RAW_INLINE by floating_h;
        sub @RAW_INLINE_NO_I l' @RAW_INLINE by floating_l;
        # j / h / l between a solid onset and a vowel
        sub @RAW_SOLID j' @RAW_INLINE by floating_j;
        sub @RAW_SOLID h' @RAW_INLINE by floating_h;
        sub @RAW_SOLID l' @RAW_INLINE by floating_l;
        # raw j / h / l after a nucleus become coda-like by default
        sub @RAW_INLINE j' by coda_j;
        sub @RAW_INLINE h' by coda_h;
        sub @RAW_INLINE l' by coda_l;
        # i floating cases
        sub @RAW_INLINE_NO_I i' @RAW_INLINE by floating_i;
        sub @RAW_SOLID i' @RAW_INLINE by floating_i;
        sub @RAW_INLINE i' @RAW_LINE_CODA by floating_i;
        # i before k is the special full-width coda-like i
        sub @RAW_INLINE i' k by coda_i;
    } RAW_FLOATING_HINTS;
    # Prefix hints for i / o.
    # This is intentionally conservative: prefix_o is a logical/helper state
    # only, same outline as o.
    lookup PREFIX_HINTS {
        lookupflag IgnoreMarks;
        # single-solid onset after i / o
        sub i' @RAW_ONSET_TAILS @RAW_INLINE by prefix_i;
        sub o' @RAW_ONSET_TAILS @RAW_INLINE by prefix_o;
        # two-solid onset after i / o
        sub i' @RAW_ONSET_HEADS @RAW_ONSET_TAILS @RAW_INLINE by prefix_i;
        sub o' @RAW_ONSET_HEADS @RAW_ONSET_TAILS @RAW_INLINE by prefix_o;
    } PREFIX_HINTS;
    # =========================================================================
    # PASS 3 — TAG THE LAST SOLID OF A VALID ONSET
    # =========================================================================
    # By this point raw floating marks can already be ignored.
    #
    # The "tail" is the final solid consonant of the onset before the nucleus.
    # Example:
    #   st + a  => tail is t
    #   tk + a  => tail is k
    #   fs + a  => tail is s
    #
    # q is always standalone.
    # =========================================================================
    lookup TAG_ONSET_TAILS {
        lookupflag IgnoreMarks;
        sub k' @RAW_INLINE by onset_k;
        sub t' @RAW_INLINE by onset_t;
        sub d_seed' @RAW_INLINE by onset_d;
        sub f' @RAW_INLINE by onset_f;
        sub s' @RAW_INLINE by onset_s;
        sub n' @RAW_INLINE by onset_n;
        sub q' @RAW_INLINE by onset_q;
        sub g' @RAW_INLINE by onset_g;
    } TAG_ONSET_TAILS;
    # =========================================================================
    # PASS 4 — TAG THE FIRST SOLID OF A VALID TWO-SOLID ONSET
    # =========================================================================
    # Current frozen valid two-solid onsets:
    #   st sf ts tk tf ks kt kf fs
    #
    # We first tag the head, then collapse head+tail into a dedicated onset
    # family state.
    # =========================================================================
    lookup TAG_ONSET_HEADS {
        lookupflag IgnoreMarks;
        sub s' onset_t by onset_s;
        sub s' onset_f by onset_s;
        sub t' onset_s by onset_t;
        sub t' onset_k by onset_t;
        sub t' onset_f by onset_t;
        sub k' onset_s by onset_k;
        sub k' onset_t by onset_k;
        sub k' onset_f by onset_k;
        sub f' onset_s by onset_f;
    } TAG_ONSET_HEADS;
    lookup COLLAPSE_ONSET_CLUSTERS {
        sub onset_s onset_t by onset_st;
        sub onset_s onset_f by onset_sf;
        sub onset_t onset_s by onset_ts;
        sub onset_t onset_k by onset_tk;
        sub onset_t onset_f by onset_tf;
        sub onset_k onset_s by onset_ks;
        sub onset_k onset_t by onset_kt;
        sub onset_k onset_f by onset_kf;
        sub onset_f onset_s by onset_fs;
    } COLLAPSE_ONSET_CLUSTERS;
    # prefix_o forces a following plain t into the d-family.
    lookup PREFIX_O_FORCES_D_FAMILY {
        lookupflag IgnoreMarks;
        sub prefix_o onset_t' by onset_d;
    } PREFIX_O_FORCES_D_FAMILY;
    # =========================================================================
    # PASS 5 — TAG CODAS ON WHAT IS LEFT
    # =========================================================================
    # Ambiguity preference frozen here:
    # - onset-preferring when ambiguous: f, k, t (and the clearly onset-only
    #   letters n, q, d, g when they stand before a nucleus)
    # - coda-preferring when ambiguous: s, j, h
    #
    # Because onset tagging already happened above, the remaining raw letters
    # after a nucleus are taken as codas.
    #
    # l is handled through the coda_l helper and later sized into one of the
    # width-specific coda-l forms.
    # =========================================================================
    lookup TAG_CODAS {
        lookupflag IgnoreMarks;
        sub @RAW_INLINE s' by coda_s;
        sub @RAW_INLINE j' by coda_j;
        sub @RAW_INLINE h' by coda_h;
        sub @RAW_INLINE l' by coda_l;
        sub @RAW_INLINE f' by coda_f;
        sub @RAW_INLINE n' by coda_n;
        sub @RAW_INLINE t' by coda_t;
        sub @RAW_INLINE k' by coda_k;
    } TAG_CODAS;
    # Whatever is still raw consonant material becomes isolated.
    lookup ISOLATED_FALLBACK {
        sub k by isolated_k;
        sub t by isolated_t;
        sub d_seed by isolated_d;
        sub f by isolated_f;
        sub n by isolated_n;
        sub q by isolated_q;
        sub g by isolated_g;
        sub j by isolated_j;
        sub h by isolated_h;
        sub l by isolated_l;
        # Bare leftover s has no dedicated isolated_s in the legacy set.
        # For now we keep onset_s as the fallback s-state.
        sub s by onset_s;
    } ISOLATED_FALLBACK;
    # =========================================================================
    # PASS 6 — CONTEXTUAL CHOICE OF b / b2 and u / u2
    # =========================================================================
    # Frozen rules:
    # - q forces b2 and u2
    # - u2 survives with mid-joined consonants (f / k / g / n) and q, but not
    #   after t / d / s families
    # - b2 can be typed stylistically, but is forced back to b in incompatible
    #   contexts and before a non-floating coda
    # =========================================================================
    lookup CONTEXTUAL_VARIANTS {
        lookupflag IgnoreMarks;
        # q forces the stylistic right-leaning forms
        sub onset_q b' by b2;
        sub onset_q u' by u2;
        # u2 is not allowed after t / d / s families
        sub [onset_t onset_d onset_st onset_kt onset_s onset_ts onset_ks onset_fs prefix_o] u2' by u;
        # b2 also falls back in those incompatible left contexts
        sub [onset_t onset_d onset_st onset_kt onset_s onset_ts onset_ks onset_fs] b2' by b;
        # non-floating codas force b2 / u2 back when required
        sub b2' [coda_f coda_n coda_t coda_s] by b;
        sub u2' [coda_f coda_n coda_t coda_s] by u;
    } CONTEXTUAL_VARIANTS;
    # =========================================================================
    # PASS 7 — SIZE L ABOVE / BELOW RAW VOWELS
    # =========================================================================
    # floating_l is chosen when l belongs to the nucleus.
    # coda_l is chosen when l belongs below the line.
    #
    # Width map:
    # - ll: a, p
    # - ss: o, y, c
    # - ls: e, b, u
    # - sl: b2, u2
    #
    # When s (or prefix_s) connects into l, l is forced to be long on the left.
    # =========================================================================
    lookup SIZE_L_BRIDGES {
        lookupflag IgnoreMarks;
        sub floating_l' @RAW_L_LL by ll_l;
        sub floating_l' @RAW_L_SS by ss_l;
        sub floating_l' @RAW_L_LS by ls_l;
        sub floating_l' @RAW_L_SL by sl_l;
        sub @RAW_L_LL coda_l' by ll_coda_l;
        sub @RAW_L_SS coda_l' by ss_coda_l;
        sub @RAW_L_LS coda_l' by ls_coda_l;
        sub @RAW_L_SL coda_l' by sl_coda_l;
    } SIZE_L_BRIDGES;
    lookup PREFIX_S_Q_LIG {
        lookupflag IgnoreMarks;
        sub prefix_s onset_q by _sq_;
    } PREFIX_S_Q_LIG;
    lookup S_FORCES_LEFT_LONG_ON_L {
        lookupflag IgnoreMarks;
        sub [s prefix_s] ss_l' by ls_l;
        sub [s prefix_s] sl_l' by ll_l;
        sub [s prefix_s] ss_coda_l' by ls_coda_l;
        sub [s prefix_s] sl_coda_l' by ll_coda_l;
    } S_FORCES_LEFT_LONG_ON_L;
    lookup S_L_LIGATURES {
        lookupflag IgnoreMarks;
        sub s ls_l by _s__ls_l;
        sub s ll_l by _s__ll_l;
    } S_L_LIGATURES;
    # =========================================================================
    # PASS 8 — SPLIT INLINE NUCLEI
    # =========================================================================
    # i remains a full-width inline glyph and is not split into halves.
    # All the other inline vowels are split here.
    # =========================================================================
    lookup SPLIT_INLINE_NUCLEI {
        sub a by a_ _a;
        sub e by a_ _e;
        sub p by a_ _p;
        sub o by o_ _o;
        sub y by o_ _y;
        sub b by b_ _o;
        sub b2 by o_ _b2;
        sub c by c_ _c;
        sub u by u_ _u;
        sub u2 by u2_ _u2;
    } SPLIT_INLINE_NUCLEI;
    # =========================================================================
    # PASS 9 — EXPAND ONSET FAMILY STATES INTO VISIBLE HEADS / BODIES
    # =========================================================================
    # This is the central structural pass.
    #
    # Single families:
    #   t   -> t_ + body_t
    #   d   -> d_ + body_d
    #   s   -> s_ + body_s
    #   k   -> k_mid_ / k_low_
    #   f   -> mid_f / low_f
    #   n   -> onset_n (double family, no separate head/body split here)
    #   q   -> onset_q
    #   g   -> g_mid_ / g_low_   (canonical simplified implementation)
    #
    # Cluster families:
    #   st  -> s_d_ + body_d
    #   kt  -> k_d_ + body_d
    #   ts  -> t_s_ + body_s
    #   ks  -> k_s_ + body_s
    #   fs  -> f_s_mid_/f_s_low_ + body_s
    #   tk  -> t_k_mid_/t_k_low_ + k_mid_/k_low_
    #   tf  -> t_f_mid_/t_f_low_ + mid_f/low_f
    #   kf  -> k_f_mid_/k_f_low_ + mid_f/low_f
    #   sf  -> s_f_mid_/s_f_low_ + mid_f/low_f
    # =========================================================================
    lookup EXPAND_ONSET_FAMILIES {
        lookupflag IgnoreMarks;
        sub onset_t by t_ body_t;
        sub onset_d by d_ body_d;
        sub onset_st by s_d_ body_d;
        sub onset_kt by k_d_ body_d;
        sub onset_s by s_ body_s;
        sub onset_ts by t_s_ body_s;
        sub onset_ks by k_s_ body_s;
        sub onset_k' @LEFT_MID_CLASS by k_mid_;
        sub onset_k' @LEFT_LOW_CLASS by k_low_;
        sub onset_f' @LEFT_MID_CLASS by mid_f;
        sub onset_f' @LEFT_LOW_CLASS by low_f;
        sub onset_tk' @LEFT_MID_CLASS by t_k_mid_ k_mid_;
        sub onset_tk' @LEFT_LOW_CLASS by t_k_low_ k_low_;
        sub onset_tf' @LEFT_MID_CLASS by t_f_mid_ mid_f;
        sub onset_tf' @LEFT_LOW_CLASS by t_f_low_ low_f;
        sub onset_kf' @LEFT_MID_CLASS by k_f_mid_ mid_f;
        sub onset_kf' @LEFT_LOW_CLASS by k_f_low_ low_f;
        sub onset_sf' @LEFT_MID_CLASS by s_f_mid_ mid_f;
        sub onset_sf' @LEFT_LOW_CLASS by s_f_low_ low_f;
        sub onset_fs' @LEFT_MID_CLASS by f_s_mid_ body_s;
        sub onset_fs' @LEFT_LOW_CLASS by f_s_low_ body_s;
        # Canonical frozen simplification for g:
        # g behaves like a double-class onset, but we make the visible body
        # explicit here as g_mid_ / g_low_ so the feature stays simple.
        sub onset_g' @LEFT_MID_CLASS by g_mid_;
        sub onset_g' @LEFT_LOW_CLASS by g_low_;
    } EXPAND_ONSET_FAMILIES;
    # =========================================================================
    # PASS 10 — CONVERT body_t / body_d / body_s INTO THE CORRECT RIGHT PIECE
    # =========================================================================
    # The left head already exists (t_, d_, s_d_, k_d_, s_, t_s_, k_s_, f_s_*).
    # These helper bodies only choose the right piece based on the next vowel
    # left-half class.
    # =========================================================================
    lookup BODY_TO_RIGHT_PIECES {
        lookupflag IgnoreMarks;
        # t family
        sub body_t a_' by _t_a_;
        sub body_t b_' by _t_b_;
        sub body_t c_' by _t_c_;
        sub body_t o_' by _t_o_;
        sub body_t u_' by _t_u_;
        # d family
        sub body_d a_' by _d_a_;
        sub body_d b_' by _d_b_;
        sub body_d c_' by _d_c_;
        sub body_d o_' by _d_o_;
        sub body_d u_' by _d_u_;
        # s family
        sub body_s a_' by _s_a_;
        sub body_s b_' by _s_b_;
        sub body_s c_' by _s_c_;
        sub body_s o_' by _s_o_;
        sub body_s u_' by _s_u;
        sub body_s u2_' by _s_u2_;
    } BODY_TO_RIGHT_PIECES;
    # =========================================================================
    # PASS 11 — GENERIC LEFT-SIDE VOWEL JOINS FOR k / f / n / g
    # =========================================================================
    # k and f use the generic mid/low left entries.
    # n and g use the double-family left entries.
    #
    # If a vowel has no explicit double form, it simply stays in its plain left
    # form; the relevant cases here are only the ones that do have dedicated
    # double-family left forms.
    # =========================================================================
    lookup GENERIC_LEFT_JOINS {
        lookupflag IgnoreMarks;
        # k / f family => mid-left
        sub [k_mid_ mid_f] a_' by _mid_a_;
        sub [k_mid_ mid_f] c_' by _mid_c_;
        sub [k_mid_ mid_f] b_' by _mid_b_;
        sub [k_mid_ mid_f] u2_' by _mid_u2_;
        # k / f family => low-left
        sub [k_low_ low_f] o_' by _low_o_;
        # n / g family => double-left
        sub [onset_n g_mid_ g_low_] a_' by _double_a_;
        sub [onset_n g_mid_ g_low_] c_' by _double_c_;
        sub [onset_n g_mid_ g_low_] o_' by _double_o_;
        sub [onset_n g_mid_ g_low_] u2_' by _double_u2_;
    } GENERIC_LEFT_JOINS;
    # =========================================================================
    # PASS 12 — EXPLICIT VOWEL-PAIR JOINS INSIDE THE NUCLEUS
    # =========================================================================
    # Only the explicitly listed pairs get custom middle pieces.
    # Every other pair just sits as plain right-half + plain left-half.
    # =========================================================================
    lookup EXPLICIT_VOWEL_PAIR_JOINS {
        lookupflag IgnoreMarks;
        sub _a' o_ by _ao_;
        sub _a' c_ by _ac_;
        sub _a' u_ by _au_;
        sub _p' a_ by _pa_;
        sub _p' c_ by _pc_;
        sub _c' a_ by _ca_;
        sub _c' o_ by _co_;
        sub _c' c_ by _cc_;
        sub _c' u_ by _cu_;
        sub _o' a_ by _oa_;
        sub _o' c_ by _oc_;
        sub _y' a_ by _ya_;
        sub _y' o_ by _yo_;
        sub _y' c_ by _yc_;
    } EXPLICIT_VOWEL_PAIR_JOINS;
    # =========================================================================
    # PASS 13 — VOWEL RIGHT-SIDE FORMS IN FRONT OF CODAS
    # =========================================================================
    # If the vowel has:
    # - a dedicated mid / low / double / s form => use it
    # - no dedicated double form => fall back to the simple insertion point
    #   on that side (e.g. b2 + n uses _b2_mid_, not a new double form)
    # =========================================================================
    lookup VOWEL_RIGHT_FOR_CODAS {
        lookupflag IgnoreMarks;
        # a
        sub _a' [coda_f coda_t] by _a_mid_;
        sub _a' coda_n by _a_double_;
        sub _a' coda_s by _a_s_;
        # e
        sub _e' [coda_f coda_t] by _e_low_;
        sub _e' coda_s by _e_s_;
        # p
        sub _p' [coda_f coda_t] by _p_mid_;
        sub _p' coda_n by _p_n_;
        sub _p' coda_s by _p_s_;
        # c
        sub _c' [coda_f coda_t] by _c_mid_;
        sub _c' coda_n by _c_double_;
        sub _c' coda_s by _c_s_;
        # o / b share _o on the right
        sub _o' [coda_f coda_t] by _o_low_;
        sub _o' coda_n by _o_double_;
        sub _o' coda_s by _o_s_;
        # y
        sub _y' [coda_f coda_t] by _y_low_;
        sub _y' coda_n by _y_double_;
        sub _y' coda_s by _y_s_;
        # b2
        sub _b2' [coda_f coda_t] by _b2_mid_;
        sub _b2' coda_n by _b2_mid_;
        sub _b2' coda_s by _b2_s_;
        # u
        sub _u' [coda_f coda_t] by _u_mid_;
        sub _u' coda_n by _u_double_;
        # u2
        sub _u2' [coda_f coda_t] by _u2_low_;
        sub _u2' coda_n by _u2_low_;
        sub _u2' coda_s by _u2_s_;
    } VOWEL_RIGHT_FOR_CODAS;
    # =========================================================================
    # PASS 14 — FINALIZE THE LINEAR CODAS THEMSELVES
    # =========================================================================
    # By now the preceding vowel has already chosen a right-side family.
    # So:
    # - coda_f becomes mid_f / low_f
    # - coda_t becomes coda_t_mid / coda_t_low
    # - coda_s becomes _mid_coda_s / _low_coda_s
    # - coda_k gets a special shape after full-width i
    # =========================================================================
    lookup FINALIZE_LINEAR_CODAS {
        lookupflag IgnoreMarks;
        sub @RIGHT_MID_CLASS coda_f' by mid_f;
        sub @RIGHT_LOW_CLASS coda_f' by low_f;
        sub @RIGHT_MID_CLASS coda_t' by coda_t_mid;
        sub @RIGHT_LOW_CLASS coda_t' by coda_t_low;
        sub @RIGHT_MID_CLASS coda_s' by _mid_coda_s;
        sub @RIGHT_LOW_CLASS coda_s' by _low_coda_s;
        sub [coda_i isolated_i] coda_k' by coda_k_i;
    } FINALIZE_LINEAR_CODAS;
    # =========================================================================
    # PASS 15 — PREFIX-S SPECIALS AFTER THE BODIES EXIST
    # =========================================================================
    # prefix_s before typed d:
    # - prefix_s itself may need an alternate left shape
    # - d_mark also has an alternate form in this context
    #
    # prefix_s + ks also has its own special head according to the latest notes.
    # =========================================================================
    lookup PREFIX_S_SPECIALS {
        lookupflag IgnoreMarks;
        sub prefix_s d_mark' by d_mark_ps;
        sub prefix_s d_' by prefix_s_d_;
        sub prefix_s k_s_' by sk_s_;
    } PREFIX_S_SPECIALS;
    # =========================================================================
    # PASS 16 — ALIASES / CLEANUP
    # =========================================================================
    # coda_i is only a logical state; visually it is the same full-width form as
    # isolated_i.
    # =========================================================================
    lookup CARRY_OVER_CODA_I_ALIAS {
        sub coda_i by isolated_i;
    } CARRY_OVER_CODA_I_ALIAS;
    # =========================================================================
    # PASS 17 — POSITIONING (TO BE FILLED WITH REAL VALUES)
    # =========================================================================
    # The structural logic is already frozen above. What remains for readability:
    # - prefix height placement
    # - q and prefix spacing
    # - stacking of d_mark / d_mark_ps
    # - optional g-mark approach if g is later re-split graphically
    # - final line/coda/floating cosmetic translations
    #
    # Example syntax to be filled later:
    #
    # lookup POSITION_PREFIXES {
    #     lookupflag IgnoreMarks;
    #     pos prefix_i [onset_k onset_t onset_d] <0 480 0 0>;
    #     pos prefix_s [onset_q] <0 520 0 0>;
    # } POSITION_PREFIXES;
    #
    # lookup POSITION_MARKS {
    #     pos d_ d_mark <0 220 0 0>;
    #     pos prefix_s_d_ d_mark_ps <0 220 0 0>;
    # } POSITION_MARKS;
    #
    # =========================================================================
} ccmp;